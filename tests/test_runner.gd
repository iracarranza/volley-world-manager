	var serve = BALL_TRAJECTORY_SCRIPT.create(
		"serve", Vector2(0.80, 0.08), Vector2(0.55, 0.48),
		Vector2(0.22, 0.84), 0.0, 1.1, 2.8, 2.3, 0.45,
	)
